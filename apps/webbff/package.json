{
	"name": "webbff",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"clean": "rimraf dist",
		"dev": "bash -c \"NIKKI_BFF_CLIENT_ROOT_PATH=$(realpath ../webapp) ts-node src/main.ts\"",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint . --cache",
		"test": "vitest run",
		"start": "node dist/main.js"
	},
	"dependencies": {
		"@opentelemetry/api": "~1.9.1",
		"@opentelemetry/context-async-hooks": "~2.12.0",
		"@opentelemetry/core": "~2.12.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "~0.223.0",
		"@opentelemetry/exporter-trace-otlp-http": "~0.223.0",
		"@opentelemetry/resources": "~2.12.0",
		"@opentelemetry/sdk-trace-base": "~2.12.0",
		"@opentelemetry/sdk-trace-node": "~2.12.0",
		"@opentelemetry/semantic-conventions": "~1.44.0",
		"busboy": "~1.6.0",
		"compression": "~1.8.1",
		"cookie": "~1.1.1",
		"cors": "~2.8.5",
		"dotenv": "~17.2.3",
		"express": "~5.1.0",
		"uuid": "~14.0.3"
	},
	"devDependencies": {
		"@types/busboy": "~1.5.5",
		"@types/compression": "~1.8.1",
		"@types/cors": "~2.8.19",
		"@types/express": "~5.0.4",
		"@types/node": "~24.9.1",
		"ts-node": "~10.9.2",
		"typescript": "~5.9.3",
		"vite": "~8.0.8",
		"vitest": "~4.0.3"
	}
}
