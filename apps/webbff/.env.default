# These are DEFAULT config values
# DO NOT edit just for your personal local development. Use .env.sample instead.

# These variables are sent to Frontend and publicly visible
# BASE_API_URL is not read from here: webbff always sends its own `/api` prefix to the browser.
NIKKI_PUBLIC_ROOT_DOMAIN=localhost
NIKKI_PUBLIC_ROOT_PATH=''
NIKKI_PUBLIC_MAPLIBRE_GL_API_KEY=''

# Variables for BFF Service, not visible to frontend
NODE_ENV=local
NIKKI_BFF_CLIENT_ROOT_PATH=''
NIKKI_BFF_HTTP_PORT='3000'
NIKKI_BFF_HTTP_HOST=''
NIKKI_BFF_HTTPS_ENABLED=false

# Upstream business service (Go application)
NIKKI_BFF_UPSTREAM_BASE_URL=https://cityboi.extapi-local.coremart.local:4433
NIKKI_BFF_UPSTREAM_FORWARD_HOST=false
NIKKI_BFF_UPSTREAM_TIMEOUT_MS=30000
# Minutes an upstream meta/schema (and schema graph) stays in the BFF's memory. Positive integer, else 30.
NIKKI_BFF_SCHEMA_CACHE_TTL_MINS=30
# Comma-separated PEM files; relative paths resolve against NIKKI_BFF_CLIENT_ROOT_PATH. See README.
NIKKI_BFF_UPSTREAM_CA_FILE=''
NIKKI_BFF_UPSTREAM_CLIENT_CERT_FILE=''
NIKKI_BFF_UPSTREAM_CLIENT_KEY_FILE=''
# Local only: the backend's non-prod CA is not shipped with the frontend repo.
NIKKI_BFF_UPSTREAM_TLS_INSECURE=true

# auto = Secure when NIKKI_BFF_HTTPS_ENABLED=true; or true / false
NIKKI_BFF_COOKIE_SECURE=auto
# Comma-separated origins allowed to call the BFF cross-origin (dev only). Empty = same-origin only.
NIKKI_BFF_CORS_ORIGINS=''

# OpenTelemetry (standard names; a non-empty NIKKI_BFF_OTEL_<NAME> wins over OTEL_<NAME>). See README "Telemetry".
OTEL_SERVICE_NAME=coremart-bff
# e.g. service.version=1.0.0,deployment.environment.name=staging (service.instance.id is always per process)
OTEL_RESOURCE_ATTRIBUTES=''
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# none | otlp | console. otlp needs OTEL_EXPORTER_OTLP_ENDPOINT, else nothing is exported.
OTEL_TRACES_EXPORTER=none
# http/json (http/protobuf is sent as JSON) or grpc
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_ENDPOINT=''
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_EXPORT_TIMEOUT=30000
# Core Mart policy: baggage keys kept (empty drops all; max 16 entries / 2048 bytes), hostnames that receive
# traceparent/tracestate/baggage/X-Idempotency-ID (empty = the NIKKI_BFF_UPSTREAM_BASE_URL hostname only),
# and the bound of the telemetry flush on shutdown (capped at 4000, under the 5s forced exit).
NIKKI_BFF_TELEMETRY_BAGGAGE_ALLOWLIST=''
NIKKI_BFF_TELEMETRY_PROPAGATION_HOST_ALLOWLIST=''
NIKKI_BFF_TELEMETRY_SHUTDOWN_FLUSH_MS=3000
