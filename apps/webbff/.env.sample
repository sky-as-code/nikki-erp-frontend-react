# Copy this file to .env.local to use locally.

NODE_ENV=local

# Verify the local backend certificate instead of skipping verification. The server certificate
# (extapi-local.coremart.local) is signed by the intermediate coremart-server-ca-nonprod, itself signed by
# coremart-root-ca-nonprod; Node needs both. Use absolute paths to your backend checkout:
# NIKKI_BFF_UPSTREAM_CA_FILE=F:/CoreVision/coreplatform-backend/scripts/cert/pki/server-ca/coremart-server-ca-nonprod.crt,F:/CoreVision/coreplatform-backend/scripts/cert/pki/root-ca/coremart-root-ca-nonprod.crt
# NIKKI_BFF_UPSTREAM_TLS_INSECURE=false
