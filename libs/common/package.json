{
	"name": "@nikkierp/common",
	"private": false,
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"clean": "rimraf dist",
		"dev": "echo 'Go to shellbff and run pnpm dev'",
		"build": "pnpm clean && pnpm build:client && pnpm build:server",
		"build:client": "tsc && vite build --outDir dist/app/client",
		"build:server": "tsc -p tsconfig.server.json",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm eslint && pnpm stylelint",
		"eslint": "eslint . --cache",
		"stylelint": "stylelint '**/*.css' --cache",
		"test": "pnpm typecheck && pnpm lint && pnpm vitest"
	},
	"dependencies": {
		"@opentelemetry/api": "~1.9.1",
		"@opentelemetry/core": "~2.12.0",
		"@opentelemetry/exporter-trace-otlp-http": "~0.223.0",
		"@opentelemetry/resources": "~2.12.0",
		"@opentelemetry/sdk-trace-base": "~2.12.0",
		"@opentelemetry/sdk-trace-web": "~2.12.0",
		"@opentelemetry/semantic-conventions": "~1.44.0",
		"chart.js": "~4.4.9",
		"clsx": "~2.1.1",
		"dayjs": "~1.11.18",
		"ky": "~1.12.0",
		"uuid": "~14.0.3",
		"zod": "~4.1.13"
	},
	"devDependencies": {
		"@types/node": "~22.14.1",
		"cross-env": "~7.0.3",
		"typescript": "~5.9.2",
		"vite": "~8.0.8",
		"vite-tsconfig-paths": "~5.1.4",
		"vitest": "~3.2.4"
	},
	"peerDependencies": {
		"typescript": "~5.9.2"
	},
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./commandBus": "./src/commandBus/index.ts",
		"./dynamicModel": "./src/dynamicModel/index.ts",
		"./entitlements": "./src/entitlements/index.ts",
		"./eventBus": "./src/eventBus/index.ts",
		"./request": "./src/request/index.ts",
		"./service": "./src/service/index.ts",
		"./types": "./src/types/index.ts",
		"./utils": "./src/utils/index.ts"
	},
	"files": [
		"src",
		"README.md"
	]
}